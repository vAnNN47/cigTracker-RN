# Copy to .env and fill in. .env is gitignored — never commit real values.
# EXPO_PUBLIC_* is bundled into the client app (public by design — safe to ship).
# NEVER put a Supabase service_role key or a Google OAuth client_secret here.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
