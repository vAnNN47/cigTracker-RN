# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# env — ignore every variant, keep only the committed template
.env
.env.*
!.env.example

# Claude Code — personal, per-machine (shared config stays in settings.json)
.claude/settings.local.json

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Marketplace skills (skills.sh) — restore with `npx skills add` from skills-lock.json.
# The materialized files + the absolute symlink are machine-specific; the lockfile is the manifest.
/.agents/
/.claude/skills/skill-creator
